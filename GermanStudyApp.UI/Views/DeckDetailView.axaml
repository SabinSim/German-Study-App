<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GermanStudyApp.UI.ViewModels"
             xmlns:models="using:GermanStudyApp.Core.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:converters="using:GermanStudyApp.UI.Converters"
             x:Class="GermanStudyApp.UI.Views.DeckDetailView"
             x:DataType="vm:DeckDetailViewModel">

    <UserControl.Resources>
        <converters:LeechConverter x:Key="LeechConverter" />
        <converters:SuspendedOpacityConverter x:Key="SuspendedOpacityConverter" />
        <converters:SuspendButtonTextConverter x:Key="SuspendButtonTextConverter" />
    </UserControl.Resources>

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button Content="← Back to decks" Click="OnBackClick" />
            <TextBlock Text="{Binding Deck.Name}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
            <TextBlock Text="Loading..." IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 단어 직접 추가 폼: 예문은 저장 시 자동으로 생성된다 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <TextBox Text="{Binding NewWord}" Watermark="German word" Width="160" />
            <TextBox Text="{Binding NewMeaning}" Watermark="Meaning" Width="160" />
            <Button Content="Add word" Command="{Binding AddWordCommand}" IsEnabled="{Binding !IsSavingNewWord}" />
            <TextBlock Text="Generating example..." VerticalAlignment="Center" Foreground="Gray"
                       IsVisible="{Binding IsSavingNewWord}" />
        </StackPanel>

        <!-- txt 파일 일괄 임포트 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Import from .txt file..." Click="OnChooseFileClick" />
            <TextBox Text="{Binding SearchText}" Watermark="Search word or meaning..." Width="200" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}"
                   Foreground="IndianRed" Margin="0,8,0,0"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

        <TextBlock Grid.Row="4" Text="{Binding SuccessMessage}"
                   Foreground="SeaGreen" Margin="0,8,0,0"
                   IsVisible="{Binding SuccessMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

        <!-- txt 임포트 미리보기: 파일을 고르면 여기 나타나고, 체크한 것만 저장한다 -->
        <Border Grid.Row="5" IsVisible="{Binding HasPreview}"
                BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,12,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Preview: uncheck any words you don't want to save" FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding PreviewEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImportEntryItem">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      Content="{Binding Entry.Word}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Save selected" Command="{Binding SaveImportedCommand}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="6" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding GroupedEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VocabDateGroup">
                        <StackPanel Margin="0,0,0,20" Spacing="6">

                            <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}"
                                       FontWeight="Bold" FontSize="15"
                                       Foreground="CornflowerBlue" />

                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VocabEntry">
                                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0,8"
                                                Opacity="{Binding IsSuspended, Converter={StaticResource SuspendedOpacityConverter}}">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Word}" FontWeight="Bold" FontSize="15" />
                                                        <TextBlock Text="🔴 Leech"
                                                                   Foreground="IndianRed" FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding AgainCount, Converter={StaticResource LeechConverter}}" />
                                                        <TextBlock Text="⏸ Suspended"
                                                                   Foreground="Gray" FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsSuspended}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" Foreground="Gray" />
                                                    <TextBlock Text="{Binding ExampleSentence}" TextWrapping="Wrap"
                                                               FontStyle="Italic" Foreground="DarkSlateGray"
                                                               IsVisible="{Binding ExampleSentence, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding BoxLevel, StringFormat='Box {0}'}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <Button Grid.Column="2"
                                                        Content="{Binding IsSuspended, Converter={StaticResource SuspendButtonTextConverter}}"
                                                        Click="OnToggleSuspendClick"
                                                        CommandParameter="{Binding}"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center" />
                                                <Button Grid.Column="3"
                                                        Content="Delete"
                                                        Click="OnDeleteWordClick"
                                                        CommandParameter="{Binding}"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Foreground="IndianRed"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
