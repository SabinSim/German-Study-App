<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GermanStudyApp.UI.ViewModels"
        xmlns:views="using:GermanStudyApp.UI.Views"
        x:Class="GermanStudyApp.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="German Study App"
        Width="800" Height="650">

    <TabControl>
        <TabItem Header="Decks">
            <Panel>
                <views:DeckView DataContext="{Binding DeckVM}" IsVisible="{Binding !IsViewingDeckDetail}" />
                <views:DeckDetailView x:Name="DeckDetailViewControl"
                                      DataContext="{Binding DeckDetailVM}"
                                      IsVisible="{Binding IsViewingDeckDetail}" />
            </Panel>
        </TabItem>
        <TabItem Header="Flashcards">
            <views:FlashcardView DataContext="{Binding FlashcardVM}" />
        </TabItem>
        <TabItem Header="Stats">
            <views:StatsView DataContext="{Binding StatsVM}" />
        </TabItem>
    </TabControl>

</Window>
