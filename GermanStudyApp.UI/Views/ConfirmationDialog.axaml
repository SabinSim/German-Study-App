<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GermanStudyApp.UI.Views"
        x:Class="GermanStudyApp.UI.Views.ConfirmationDialog"
        x:DataType="views:ConfirmationDialog"
        Title="Confirmation"
        Width="400" Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <Grid Margin="20" RowDefinitions="*,Auto">
        <TextBlock Grid.Row="0" 
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="14" />
        
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Spacing="12"
                    Margin="0,20,0,0">
            <Button Content="Yes" 
                    Width="80" 
                    Click="OnYesClick" />
            <Button Content="No" 
                    Width="80" 
                    Click="OnNoClick" />
        </StackPanel>
    </Grid>
</Window>

